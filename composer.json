{
    "name": "symfonycasts/object-translation-bundle",
    "description": "Translate your entities!",
    "type": "symfony-bundle",
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "SymfonyCasts\\ObjectTranslationBundle\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "SymfonyCasts\\ObjectTranslationBundle\\Tests\\": "tests/"
        }
    },
    "authors": [
        {
            "name": "Kevin Bond",
            "email": "kevinbond@gmail.com"
        }
    ],
    "require": {
        "php": ">=8.2",
        "symfony/framework-bundle": "^6.4|^7.0",
        "symfony/translation": "^6.4|^7.0",
        "doctrine/doctrine-bundle": "^2.18|^3.0",
        "doctrine/orm": "^3.5"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.6",
        "symfony/phpunit-bridge": "^7.3",
        "zenstruck/foundry": "^2.8",
        "php-cs-fixer/shim": "^3.90",
        "phpstan/phpstan": "^2.1",
        "twig/twig": "^3.22"
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
